{
  "name": "nanoland-management-system",
  "version": "0.1.0",
  "private": true,
  "description": "Sistem manajemen pengembang properti Nanoland — demo internal",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/lib/**/*.test.ts\"",
    "db:generate": "prisma generate",
    "db:push": "prisma db push && prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "node scripts/hapus-db.mjs && prisma db push && prisma generate && prisma db seed",
    "db:studio": "prisma studio",
    "skema:postgres": "tsx scripts/skema-postgres.mjs",
    "repro:slash": "tsx scripts/repro-slash.ts",
    "cek:endpoint": "tsx scripts/cek-endpoint-pindahan.ts",
    "cek:bukti": "tsx scripts/cek-bukti-pindahan.ts",
    "bangun:portabel": "node scripts/bangun-portabel.mjs",
    "skema:sql": "tsx scripts/skema-sql.mjs",
    "acuan:sql": "node scripts/acuan-sql.mjs"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "jose": "^6.2.4",
    "lucide-react": "^1.26.0",
    "next": "^16.2.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "pg-query-emscripten": "^5.1.0",
    "prisma": "^7.9.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
