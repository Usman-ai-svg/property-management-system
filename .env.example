# Database demo. Ganti ke postgresql://... saat pindah ke Postgres,
# lalu sesuaikan `provider` di prisma/schema.prisma.
DATABASE_URL="file:./prisma/dev.db"

# Kunci penandatangan session cookie. WAJIB diganti di setiap environment.
# Bangkitkan dengan: openssl rand -base64 32
SESSION_SECRET="ganti-dengan-nilai-acak-minimal-32-karakter"

# --- Penyimpanan berkas ---------------------------------------------------
# lokal  = disk aplikasi (bawaan; demo jalan tanpa kredensial apa pun)
# gdrive = Google Drive lewat service account, untuk .skp 24–38 MB
STORAGE_ENGINE="lokal"

# Hanya perlu bila STORAGE_ENGINE="gdrive".
# Folder tujuan WAJIB dibagikan ke GDRIVE_CLIENT_EMAIL sebagai Editor —
# tanpa itu Drive menjawab 403 dan berkas tak pernah tersimpan.
# Baris baru di kunci privat boleh ditulis sebagai \n.
GDRIVE_CLIENT_EMAIL=""
GDRIVE_PRIVATE_KEY=""
GDRIVE_FOLDER_ID=""
